# Isaac for Healthcare — deploy defaults
# Copy to deploy/config/local.env and override as needed.
# Source order: defaults.env → local.env → environment variables.

# Repository
I4H_REPO_URL="${I4H_REPO_URL:-https://github.com/isaac-for-healthcare/i4h-workflows.git}"
I4H_REPO_BRANCH="${I4H_REPO_BRANCH:-main}"

# Workflow target (reusable for other i4h docker workflows)
I4H_WORKFLOW="${I4H_WORKFLOW:-robotic_ultrasound}"

# --- Storage layout ---
# Set I4H_DATA_ROOT to a mounted data disk (e.g. /data) to keep the 50GB system disk free.
# When set, heavy paths default under I4H_DATA_ROOT; ~/docker and ~/.cache are symlinked for ./i4h.
# I4H_DATA_ROOT=/data
# I4H_INSTALL_DIR=          # default: ${I4H_DATA_ROOT}/i4h-workflows  or  $HOME/i4h-workflows
# I4H_DOCKER_ROOT=          # default: ${I4H_DATA_ROOT}/docker         or  $HOME/docker
# I4H_CACHE_ROOT=           # default: ${I4H_DATA_ROOT}/cache          or  $HOME/.cache
# I4H_DOCKER_DATA_ROOT=     # default: ${I4H_DATA_ROOT}/docker-engine  (Docker images/layers)

# Persistent host paths (overrides; usually leave unset when I4H_DATA_ROOT is set)
I4H_INSTALL_DIR="${I4H_INSTALL_DIR:-}"
I4H_DOCKER_ROOT="${I4H_DOCKER_ROOT:-}"
I4H_CACHE_ROOT="${I4H_CACHE_ROOT:-}"
I4H_DOCKER_DATA_ROOT="${I4H_DOCKER_DATA_ROOT:-}"
I4H_DATA_ROOT="${I4H_DATA_ROOT:-}"

# RTI DDS license (path resolved after storage layout in resolve_storage_paths)
RTI_LICENSE_URL="${RTI_LICENSE_URL:-https://content.rti.com/l/983311/2025-07-25/q6729c}"
RTI_LICENSE_FILE="${RTI_LICENSE_FILE:-}"

# GUI / display
# auto | x11-ssh | vnc | headless
# auto: use ssh -X if DISPLAY set; else install TigerVNC+XFCE (for headless Ubuntu)
I4H_GUI_MODE="${I4H_GUI_MODE:-auto}"
I4H_VNC_DISPLAY="${I4H_VNC_DISPLAY:-:1}"
I4H_VNC_GEOMETRY="${I4H_VNC_GEOMETRY:-1920x1080}"
# Non-interactive VNC password for one-click deploy on headless servers (Mode B)
# I4H_VNC_PASSWORD=your-secure-password
I4H_VNC_ALLOW_REMOTE="${I4H_VNC_ALLOW_REMOTE:-1}"
# Register systemd i4h-vnc.service during L4 (survives reboot)
I4H_VNC_AUTOSTART="${I4H_VNC_AUTOSTART:-1}"

# GPU requirements (robotic_ultrasound ultrasound raytracing)
I4H_MIN_COMPUTE_CAP="${I4H_MIN_COMPUTE_CAP:-8.6}"
I4H_MIN_VRAM_MB="${I4H_MIN_VRAM_MB:-23000}"
I4H_MIN_DRIVER_VERSION="${I4H_MIN_DRIVER_VERSION:-535}"

# Docker test image
I4H_CUDA_TEST_IMAGE="${I4H_CUDA_TEST_IMAGE:-nvidia/cuda:12.8.1-base-ubuntu24.04}"

# Deploy behaviour
I4H_SKIP_BUILD="${I4H_SKIP_BUILD:-0}"
I4H_BUILD_NO_CACHE="${I4H_BUILD_NO_CACHE:-0}"
# Apt mirror for Docker build (China GPU servers). Empty = archive.ubuntu.com
# Comma/space-separated fallbacks when USTC is rate-limited:
I4H_APT_MIRRORS="${I4H_APT_MIRRORS:-mirrors.ustc.edu.cn mirrors.aliyun.com mirrors.tuna.tsinghua.edu.cn}"
I4H_APT_MIRROR="${I4H_APT_MIRROR:-}"
I4H_CONFIGURE_HOST_APT_MIRROR="${I4H_CONFIGURE_HOST_APT_MIRROR:-1}"
I4H_SKIP_REPO_UPDATE="${I4H_SKIP_REPO_UPDATE:-0}"
I4H_RUN_VERIFY_AFTER_DEPLOY="${I4H_RUN_VERIFY_AFTER_DEPLOY:-1}"
I4H_RUN_SMOKE_TEST="${I4H_RUN_SMOKE_TEST:-0}"
# L6 之后预拉 PI0 权重到 ${I4H_CACHE_ROOT}/huggingface（避免首次 full_pipeline 长时间下载）
I4H_PREFETCH_PI0="${I4H_PREFETCH_PI0:-1}"
# 优云/国内可选镜像（prefetch 与容器内 HF 下载）
# I4H_HF_ENDPOINT=https://hf-mirror.com

# PyPI / Miniconda mirrors (host + Docker build-args)
I4H_PIP_INDEX_URL="${I4H_PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"
I4H_PIP_TRUSTED_HOST="${I4H_PIP_TRUSTED_HOST:-pypi.tuna.tsinghua.edu.cn}"
I4H_CONDA_MIRROR="${I4H_CONDA_MIRROR:-https://mirrors.tuna.tsinghua.edu.cn/anaconda}"

# CompShare (优云智算) fresh machine bootstrap — see deploy/README.md
I4H_COMPSHARE_BOOTSTRAP="${I4H_COMPSHARE_BOOTSTRAP:-0}"
I4H_COMPSHARE_DNS="${I4H_COMPSHARE_DNS:-1}"
I4H_COMPSHARE_DNS_SERVERS="${I4H_COMPSHARE_DNS_SERVERS:-100.90.90.90 100.90.90.100}"
I4H_VERIFY_DNS_ACCELERATION="${I4H_VERIFY_DNS_ACCELERATION:-1}"
I4H_AUTO_SETUP_DATA_DISK="${I4H_AUTO_SETUP_DATA_DISK:-1}"
I4H_DATA_DISK_MOUNT="${I4H_DATA_DISK_MOUNT:-/data}"
I4H_DATA_DISK_MIN_GB="${I4H_DATA_DISK_MIN_GB:-200}"
I4H_DATA_DISK_MAX_GB="${I4H_DATA_DISK_MAX_GB:-400}"
I4H_DATA_DISK_OWNER="${I4H_DATA_DISK_OWNER:-ubuntu}"
I4H_INSTALL_SSH_KEYS="${I4H_INSTALL_SSH_KEYS:-1}"
I4H_SSH_AUTHORIZED_KEYS_FILE="${I4H_SSH_AUTHORIZED_KEYS_FILE:-}"
I4H_SSH_AUTHORIZED_USERS="${I4H_SSH_AUTHORIZED_USERS:-ubuntu}"
I4H_LOGIN_USER="${I4H_LOGIN_USER:-ubuntu}"
# I4H_SET_LOGIN_PASSWORD=your-password   # applied at end of deploy (chpasswd)
I4H_JUMP_SSH_CONFIG="${I4H_JUMP_SSH_CONFIG:-1}"
I4H_JUMP_SSH_CONFIG_PREFIX="${I4H_JUMP_SSH_CONFIG_PREFIX:-i4h-gpu}"

# L6 build progress
I4H_BUILD_SHOW_PROGRESS="${I4H_BUILD_SHOW_PROGRESS:-1}"
I4H_BUILD_PROGRESS_INTERVAL="${I4H_BUILD_PROGRESS_INTERVAL:-60}"
I4H_INSTALL_BUILDKIT="${I4H_INSTALL_BUILDKIT:-1}"

# Remote deploy (Mode B) — set in local.env or pass on CLI
# I4H_REMOTE_HOST=203.0.113.10
# I4H_REMOTE_USER=root
# I4H_REMOTE_PORT=22
# I4H_REMOTE_PASSWORD=          # prefer SSH key; use sshpass only when necessary
