# Copy to deploy/config/local.env and customize (this file is gitignored if you add it).

# --- Mode B: remote GPU server ---
# I4H_REMOTE_HOST=203.0.113.10
# I4H_REMOTE_USER=root
# I4H_REMOTE_PORT=22
# I4H_REMOTE_PASSWORD=your-root-password

# --- Storage (50GB system disk + large data disk) ---
# One line to move repo, caches, and Docker images off the system disk:
# I4H_DATA_ROOT=/data
#
# Or override individual paths:
# I4H_INSTALL_DIR=/data/i4h-workflows
# I4H_DOCKER_ROOT=/data/docker
# I4H_CACHE_ROOT=/data/cache
# I4H_DOCKER_DATA_ROOT=/data/docker-engine

# --- Project paths ---
# I4H_REPO_URL=https://github.com/isaac-for-healthcare/i4h-workflows.git
# I4H_REPO_BRANCH=main

# --- GUI (auto | x11-ssh | vnc | headless) ---
# Headless Ubuntu (no desktop): use vnc, or auto (detects no DISPLAY and falls back to VNC)
# I4H_GUI_MODE=vnc
# I4H_VNC_DISPLAY=:1
# I4H_VNC_PASSWORD=your-secure-password   # required for Mode B one-click (non-interactive)
# I4H_VNC_ALLOW_REMOTE=1                  # allow VNC from your PC (open port 5901 in cloud SG)

# --- Workflow ---
# I4H_WORKFLOW=robotic_ultrasound
# I4H_SKIP_BUILD=0
# I4H_BUILD_NO_CACHE=0
# I4H_RUN_VERIFY_AFTER_DEPLOY=1

# --- RTI license ---
# RTI_LICENSE_FILE=/data/docker/rti/rti_license.dat
# RTI_LICENSE_URL=https://content.rti.com/l/983311/2025-07-25/q6729c
