# Copy to deploy/config/local.env and customize (this file is gitignored if you add it).

# --- 优云智算 CompShare 新机（推荐）---
# 购买后首次 Mode B 部署建议开启：
# I4H_COMPSHARE_BOOTSTRAP=1
# I4H_DATA_ROOT=/data
# I4H_LOGIN_USER=ubuntu
# I4H_SET_LOGIN_PASSWORD=your-simple-password
# I4H_VNC_PASSWORD=your-vnc-password

# --- Mode B: remote GPU server ---
# I4H_REMOTE_HOST=203.0.113.10
# I4H_REMOTE_USER=ubuntu
# I4H_REMOTE_PORT=22
# I4H_REMOTE_PASSWORD=your-root-password

# --- Storage (50GB system disk + 300GB data disk) ---
# I4H_DATA_ROOT=/data
# I4H_AUTO_SETUP_DATA_DISK=1
# I4H_DATA_DISK_MOUNT=/data

# --- Project paths ---
# I4H_REPO_URL=https://github.com/isaac-for-healthcare/i4h-workflows.git
# I4H_REPO_BRANCH=dev_xzl
# I4H_SKIP_REPO_UPDATE=1

# --- GUI (auto | x11-ssh | vnc | headless) ---
# I4H_GUI_MODE=vnc
# I4H_VNC_DISPLAY=:1
# I4H_VNC_PASSWORD=your-secure-password
# I4H_VNC_ALLOW_REMOTE=1
# I4H_VNC_AUTOSTART=1

# --- Mirrors (China) ---
# I4H_APT_MIRRORS=mirrors.ustc.edu.cn mirrors.aliyun.com mirrors.tuna.tsinghua.edu.cn
# I4H_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# I4H_CONDA_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/anaconda

# --- SSH keys (default: deploy/config/ssh-authorized-keys.pub) ---
# I4H_INSTALL_SSH_KEYS=1
# I4H_JUMP_SSH_CONFIG=1

# --- Workflow ---
# I4H_WORKFLOW=robotic_ultrasound
# I4H_SKIP_BUILD=0
# I4H_BUILD_NO_CACHE=0
# I4H_RUN_VERIFY_AFTER_DEPLOY=1

# --- RTI license ---
# RTI_LICENSE_FILE=/data/docker/rti/rti_license.dat
# RTI_LICENSE_URL=https://content.rti.com/l/983311/2025-07-25/q6729c
